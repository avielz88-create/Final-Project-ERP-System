    {
      "id": "8b61cca5-cccd-4397-bdcc-05c747680896",
      "name": "App Chat Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        680,
        -80
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "את/ה סוכן/ת שירות לקוחות של עסק אלקטרוניקה ישראלי, פונה/ת דרך אפליקציית הניהול. עני/ה תמיד בעברית בלבד, בטון ידידותי, מקצועי ותמציתי. השתמש/י בכלי \"Search Knowledge Base\" לפני מענה על שאלות מדיניות או מוצרים, ואל תמציא/י מידע. אינך מוסמך/ת לאשר החזר כספי, לשנות מחיר או לבטל הזמנה - הפנה/י בקשות כאלה לנציג אנושי."
        }
      }
    },
